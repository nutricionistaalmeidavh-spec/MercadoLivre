# Cloudflare Worker / Mercado Livre
ML_CLIENT_ID=SEU_CLIENT_ID_ATUAL
ML_APPLICATION_ID=SEU_APPLICATION_ID_ATUAL
ML_CLIENT_SECRET=SEU_CLIENT_SECRET
ML_REDIRECT_URI=https://SEU-WORKER.workers.dev/mercadolivre/callback
TOKEN_ENCRYPTION_KEY=GERE_UMA_CHAVE_LONGA_ALEATORIA
ADMIN_PASSWORD=DEFINA_UMA_SENHA_FORTE
ADMIN_SESSION_SECRET=GERE_OUTRA_CHAVE_LONGA_ALEATORIA
ML_AUTOMATION_MODE=dry-run
ML_JOB_MAX_ATTEMPTS=5

# Fallback self-hosted opcional
ML_DB_PATH=./data/mercadolivre.sqlite
ML_WORKER_INTERVAL_MS=2000
PORT=3000
