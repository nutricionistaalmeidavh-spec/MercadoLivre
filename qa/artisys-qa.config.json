{
  "schemaVersion": 1,
  "systemId": "mercado-livre-artisys",
  "mode": "web",
  "defaultEnvironment": "production-readonly",
  "environments": {
    "production-readonly": {
      "baseURL": "https://artisys-mercadolivre.nutricionistaalmeidavh.workers.dev"
    }
  },
  "flows": {
    "post-sale": "flows/post-sale.json"
  },
  "qaProfiles": {
