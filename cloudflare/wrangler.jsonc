{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "artisys-mercadolivre",
  "main": "./src/index.mjs",
  "compatibility_date": "2026-09-10",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "artisys-mercadolivre",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "./migrations"
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  },
  "vars": {
    "ML_CLIENT_ID": "7397781723111552",
    "ML_APPLICATION_ID": "7397781723111552",
    "ML_AUTOMATION_MODE": "dry-run",
    "ML_AFTER_SALE_MESSAGE": "Olá! Recebemos seu pedido e já estamos acompanhando por aqui. Obrigado pela compra. Se precisar falar sobre este pedido, pode usar este chat.",
    "ML_JOB_MAX_ATTEMPTS": "5"
  }
}
